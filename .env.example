# Database (local MySQL, or PlanetScale / TiDB / RDS for Vercel)
# On Vercel serverless prefer a low pool size, e.g. ?connection_limit=1
DATABASE_URL=mysql://user:password@localhost:3306/sportza
MYSQL_ROOT_PASSWORD=changeme

# Redis (local, or Upstash redis:// / rediss:// for Vercel)
REDIS_URL=redis://localhost:6379

# Auth0 (optional)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.sportza.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# S3-compatible storage (AWS S3, MinIO, R2, etc.)
S3_ENDPOINT=
S3_BUCKET=sportza-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sportza.com

# Server
NODE_ENV=development
PORT=5000
# Local: http://localhost:5173
# Vercel production: https://sportza.in,https://www.sportza.in
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_in_production

# Vercel Cron — required in production on Vercel (Authorization: Bearer …)
CRON_SECRET=

# Set to 1 to simulate serverless locally (no Socket.io / BullMQ schedulers)
# SPORTZA_SERVERLESS=1
