{
  "name": "sportza",
  "version": "2.0.0",
  "private": true,
  "description": "Sportza — Book. Train. Track. Sports venue booking, training, and performance tracking.",
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "pnpm --filter @sportza/api dev",
    "dev:frontend": "pnpm --filter @sportza/web dev",
    "dev:all": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:share": "node scripts/share.js",
    "repair:deps": "powershell -ExecutionPolicy Bypass -File scripts/repair-deps.ps1",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @sportza/api exec prisma generate",
    "db:migrate": "pnpm --filter @sportza/api exec prisma migrate dev",
    "db:push": "pnpm --filter @sportza/api exec prisma db push",
    "db:studio": "pnpm --filter @sportza/api exec prisma studio",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
