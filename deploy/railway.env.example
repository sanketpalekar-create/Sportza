# ─────────────────────────────────────────────────────────────────────────────
# Copy-paste helpers for Railway Variables (do not commit real secrets)
# ─────────────────────────────────────────────────────────────────────────────

# ── API service (runtime) ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Link from Railway MySQL plugin (Variables → Add Reference):
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# or if your plugin exposes DATABASE_URL:
# DATABASE_URL=${{MySQL.DATABASE_URL}}

# Link from Railway Redis plugin:
# REDIS_URL=${{Redis.REDIS_URL}}

JWT_SECRET=generate_a_long_random_string_here
# Single-domain (sportza.in on the api service):
CLIENT_ORIGIN=https://sportza.in,https://www.sportza.in

# Auth / payments / maps / email — same keys as apps/api/.env
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAPPLS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sportza.com
S3_ENDPOINT=
S3_BUCKET=sportza-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
DEV_AUTH_FALLBACK=false

# ── SPA build args on the SAME api service (Available at Build Time) ─────────
VITE_API_URL=/api
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_MAP_PROVIDER=mappls
VITE_MAPPLS_API_KEY=
