# ─────────────────────────────────────────────────────────────────────────────
# Copy-paste helpers for Railway Variables (do not commit real secrets)
# ─────────────────────────────────────────────────────────────────────────────

# ── API service (runtime) ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Link from Railway MySQL plugin (Variables → Add Reference):
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# or if your plugin exposes DATABASE_URL:
# DATABASE_URL=${{MySQL.DATABASE_URL}}

# Link from Railway Redis plugin:
# REDIS_URL=${{Redis.REDIS_URL}}

JWT_SECRET=generate_a_long_random_string_here
CLIENT_ORIGIN=https://YOUR-WEB.up.railway.app

# Auth / payments / maps / email — same keys as apps/api/.env
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAPPLS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sportza.com
S3_ENDPOINT=
S3_BUCKET=sportza-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
DEV_AUTH_FALLBACK=false

# ── Web service (BUILD TIME — toggle "Available at Build Time") ──────────────
# After API is live, paste its public URL:
VITE_API_URL=https://YOUR-API.up.railway.app/api
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_MAP_PROVIDER=mappls
VITE_MAPPLS_API_KEY=
