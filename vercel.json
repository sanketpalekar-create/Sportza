{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @sportza/api exec prisma generate && pnpm turbo build --filter=@sportza/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "apps/api/prisma/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/hold-cleanup",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/open-play-deadline",
      "schedule": "*/5 * * * *"
    }
  ]
}
