    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "@tanstack/react-query": "^5.62.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "orval": "^7.3.0",
    "react": "^18.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
