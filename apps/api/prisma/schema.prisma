datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Location ────────────────────────────────────────────────

model Location {
  id      Int     @id @default(autoincrement())
  country String  @default("India") @db.VarChar(100)
  state   String  @db.VarChar(100)
  city    String  @db.VarChar(100)
  pincode String? @db.VarChar(10)
  address String? @db.VarChar(500)
  lat     Float?
  lng     Float?

  users       User[]
  venues      Venue[]
  matches     Match[]
  tournaments Tournament[]
  batches     Batch[]

  @@index([country, state, city])
  @@index([pincode])
  @@map("locations")
}

// ─── Identity ───────────────────────────────────────────────

model User {
  id               Int       @id @default(autoincrement())
  name             String?   @db.VarChar(255)
  email            String    @unique @db.VarChar(255)
  password         String?   @db.VarChar(255)
  phone            String?   @unique @db.VarChar(20)
  googleId         String?   @unique @db.VarChar(255)
  facebookId       String?   @unique @db.VarChar(255)
  avatar           String?   @db.VarChar(500)
  role             String    @default("player") @db.VarChar(20)
  locationId       Int?
  sports           Json?
  isActive         Boolean   @default(true)
  suspendedAt      DateTime?
  suspensionReason String?   @db.VarChar(500)
  onboardingStatus String?   @db.VarChar(30)
  onboardingNote   String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())

  location         Location? @relation(fields: [locationId], references: [id])

  ownedVenues        Venue[]
  bookings           Booking[]
  trainerBatches     Batch[]               @relation("TrainerBatches")
  trainerProfile     TrainerProfile?
  trainerVenues      TrainerVenue[]
  batchMemberships   BatchMembership[]
  batchPaymentsPayer BatchPayment[]        @relation("PayerPayments")
  batchPaymentsFor   BatchPayment[]        @relation("PlayerPayments")
  venueReviews       VenueReview[]
  trainerReviewsBy   TrainerReview[]       @relation("ReviewAuthor")
  trainerReviewsFor  TrainerReview[]       @relation("ReviewSubject")
  batchReviewsFor    PlayerBatchReview[]   @relation("ReviewedPlayer")
  batchReviewsBy     PlayerBatchReview[]   @relation("ReviewingTrainer")
  createdOpenPlays   OpenPlay[]
  openPlayPlayers    OpenPlayPlayer[]
  matchEvents        MatchEvent[]
  matchConfirms      MatchConfirmation[]
  playerStats        PlayerStats[]
  playerActStats     PlayerActivityStats[]
  participations     Participation[]
  sportEvents        SportEvent[]
  sessAttendance     SessionAttendance[]
  createdMatches     Match[]               @relation("MatchCreator")
  createdTournaments Tournament[]
  coOrganizerRoles   TournamentCoOrganizer[] @relation("CoOrganizerOf")
  createdActivities  Activity[]            @relation("ActivityCreator")
  actParticipant     ActivityParticipant[]
  refunds            Refund[]
  bookingPayments    BookingPayment[]
  batchAnnouncements BatchAnnouncement[]
  splitPayments      SplitPayment[]
  refreshTokens      RefreshToken[]
  skillRatings       SportSkillRating[]
  ratingHistory      RatingHistory[]
  playerConnections  PlayerConnection[] @relation("UserConnections")
  connectedToMe      PlayerConnection[] @relation("ConnectedTo")
  sentPeerInvites    PeerPlayInvite[]   @relation("PeerInviteSender")
  receivedPeerInvites PeerPlayInvite[]  @relation("PeerInviteReceiver")
  sentPeerRequests   PeerRelationship[] @relation("PeerRequester")
  receivedPeerRequests PeerRelationship[] @relation("PeerAddressee")
  notifications      Notification[]
  notifPrefs         NotificationPreference?
  walletAccount      WalletAccount?
  walletTransactions WalletTransaction[]
  pushSubscriptions  PushSubscription[]
  mobilePushTokens   MobilePushToken[]
  adminActedLogs     AdminAuditLog[]         @relation("AuditActor")
  adminTargetLogs    AdminAuditLog[]         @relation("AuditTarget")
  initiatedApprovals AdminApprovalRequest[]  @relation("ApprovalInitiator")
  reviewedApprovals  AdminApprovalRequest[]  @relation("ApprovalReviewer")

  @@index([isActive])
  @@map("users")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  code      String   @db.VarChar(10)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@map("otps")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(128)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model TrainerProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  bio             String?  @db.Text
  yearsExperience Int      @default(0)
  sports          Json?
  certifications  Json?
  achievements    Json?
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  reviews TrainerReview[]

  @@map("trainer_profiles")
}

model TrainerVenue {
  id       Int @id @default(autoincrement())
  userId   Int
  venueId  Int

  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([userId, venueId])
  @@map("trainer_venues")
}

// ─── Infrastructure ─────────────────────────────────────────

model Sport {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique @db.VarChar(50)
  displayName          String   @db.VarChar(100)
  defaultPricePerHour  Float?
  defaultRates         Json?
  defaultMinBookingHrs Float?
  statFields           Json?
  rulebookTitle        String?  @db.VarChar(150)
  rulebookLines        Json?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  formats             SportFormat[]
  matches             Match[]
  bookings            Booking[]
  openPlays           OpenPlay[]
  batches             Batch[]
  tournaments         Tournament[]
  activities          Activity[]
  sportRates          SportRate[]
  playerStats         PlayerStats[]
  playerActivityStats PlayerActivityStats[]
  skillRatings        SportSkillRating[]
  ratingHistory       RatingHistory[]
  sentPeerInvites     PeerPlayInvite[]

  @@map("sports")
}

model SportFormat {
  id            Int    @id @default(autoincrement())
  sportId       Int
  name          String @db.VarChar(100)
  playersPerTeam Int
  minTeams      Int    @default(2)
  maxTeams      Int    @default(2)
  description   String? @db.VarChar(500)
  config        Json?

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@map("sport_formats")
}

model Venue {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(255)
  ownerId           Int
  sports            Json?
  gstRate           Float    @default(18)
  commissionPercent Float    @default(0)
  locationId        Int?
  facilities        Json?
  capacity          Int
  pricePerHour      Float?
  images            Json?
  availability      Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  location           Location?           @relation(fields: [locationId], references: [id])
  owner              User                @relation(fields: [ownerId], references: [id])
  sportFacilities    SportFacility[]
  sportRates         SportRate[]
  addOns             VenueAddOn[]
  bookings           Booking[]
  openPlays          OpenPlay[]
  matches            Match[]
  batches            Batch[]
  tournaments        Tournament[]
  venueReviews       VenueReview[]
  trainerVenues      TrainerVenue[]
  pricingRules       FacilityPricingRule[]
  dbFacilities       Facility[]
  slots              Slot[]
  activities         Activity[]
  displays           VenueDisplay[]
  playerConnections  PlayerConnection[]
  scheduleExceptions ScheduleException[]

  @@map("venues")
}

model SportFacility {
  id          Int    @id @default(autoincrement())
  venueId     Int
  name        String @db.VarChar(255)
  surfaceType String? @db.VarChar(100)
  count       Int    @default(1)
  sports      Json?

  venue        Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  pricingRules FacilityPricingRule[]

  @@map("sport_facilities")
}

model SportRate {
  id              Int    @id @default(autoincrement())
  venueId         Int
  sportId         Int?
  sport           String @db.VarChar(50)
  minBookingHours Float?
  rates           Json?

  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sportRef Sport? @relation(fields: [sportId], references: [id])

  @@index([sportId])
  @@map("sport_rates")
}

model VenueAddOn {
  id          Int    @id @default(autoincrement())
  venueId     Int
  name        String @db.VarChar(255)
  category    String @default("other") @db.VarChar(20)
  price       Float
  unit        String @default("per_item") @db.VarChar(20)
  sport       String? @db.VarChar(50)
  description String? @db.VarChar(500)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_add_ons")
}

model Facility {
  id          Int      @id @default(autoincrement())
  venueId     Int
  name        String   @db.VarChar(255)
  surfaceType String?  @db.VarChar(100)
  sports      Json?
  count       Int      @default(1)
  createdAt   DateTime @default(now())

  venue              Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  slots              Slot[]
  schedules          FacilitySchedule[]
  scheduleExceptions ScheduleException[]

  @@index([venueId])
  @@map("facilities")
}

model Slot {
  id         Int      @id @default(autoincrement())
  facilityId Int
  venueId    Int
  startTime  DateTime
  endTime    DateTime
  price      Float
  status     String   @default("available") @db.VarChar(20)
  bookingId  Int?
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  venue    Venue    @relation(fields: [venueId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([facilityId, startTime, endTime])
  @@index([venueId, startTime, endTime])
  @@index([status, startTime])
  @@map("slots")
}

// ─── Booking Holds (temporary slot reservations) ───────────

model BookingHold {
  id         Int      @id @default(autoincrement())
  facilityId Int
  venueId    Int
  date       String   @db.VarChar(10)
  startTime  String   @db.VarChar(10)
  endTime    String   @db.VarChar(10)
  userId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([facilityId, date, startTime, endTime])
  @@index([expiresAt])
  @@map("booking_holds")
}

// ─── Facility Schedules ────────────────────────────────────

/**
 * Weekly operating template for a single facility.
 * One row per day-of-week (0=Sun … 6=Sat).
 * slotDuration is in minutes (30, 60, 90, 120).
 * breakTimes JSON: [{ start: "13:00", end: "14:00" }]
 */
model FacilitySchedule {
  id           Int      @id @default(autoincrement())
  facilityId   Int
  venueId      Int
  dayOfWeek    Int      // 0=Sun, 1=Mon … 6=Sat
  isOpen       Boolean  @default(true)
  openTime     String   @db.VarChar(5)  // "06:00"
  closeTime    String   @db.VarChar(5)  // "23:00"
  slotDuration Int      @default(60)    // minutes
  breakTimes   Json?    // [{ start: "HH:mm", end: "HH:mm" }]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, dayOfWeek])
  @@index([venueId])
  @@map("facility_schedules")
}

/**
 * Date-range overrides: holidays, events, maintenance, custom hours.
 * If facilityId is null the exception applies to the entire venue.
 * isFullBlock=true blocks the entire day; otherwise customOpen/customClose apply.
 */
model ScheduleException {
  id           Int      @id @default(autoincrement())
  facilityId   Int?
  venueId      Int
  startDate    String   @db.VarChar(10)  // "YYYY-MM-DD"
  endDate      String   @db.VarChar(10)  // "YYYY-MM-DD"
  type         String   @db.VarChar(20)  // "holiday" | "event" | "maintenance" | "custom_hours"
  label        String?  @db.VarChar(100)
  isFullBlock  Boolean  @default(true)
  customOpen   String?  @db.VarChar(5)
  customClose  String?  @db.VarChar(5)
  reason       String?  @db.VarChar(500)
  createdAt    DateTime @default(now())

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([venueId, startDate, endDate])
  @@index([facilityId, startDate])
  @@map("schedule_exceptions")
}

// ─── Pricing Rules ─────────────────────────────────────────

model FacilityPricingRule {
  id         Int      @id @default(autoincrement())
  facilityId Int
  venueId    Int
  ruleType   String   @db.VarChar(50)
  ruleValue  Float    @default(0)
  metadata   Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility SportFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  venue    Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([facilityId, isActive])
  @@index([venueId])
  @@map("facility_pricing_rules")
}

// ─── Reviews ────────────────────────────────────────────────

model VenueReview {
  id        Int      @id @default(autoincrement())
  userId    Int
  venueId   Int
  rating    Int
  review    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([venueId, userId])
  @@index([venueId])
  @@map("venue_reviews")
}

model TrainerReview {
  id               Int      @id @default(autoincrement())
  userId           Int
  trainerId        Int
  trainerProfileId Int?
  rating           Int
  review           String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation("ReviewAuthor", fields: [userId], references: [id])
  trainer        User            @relation("ReviewSubject", fields: [trainerId], references: [id])
  trainerProfile TrainerProfile? @relation(fields: [trainerProfileId], references: [id])

  @@unique([trainerId, userId])
  @@index([trainerId])
  @@index([trainerProfileId])
  @@map("trainer_reviews")
}

// ─── Marketplace ────────────────────────────────────────────

model Booking {
  id                        Int      @id @default(autoincrement())
  userId                    Int
  createdById               Int?
  bookingType               String   @default("solo") @db.VarChar(20)
  venueId                   Int
  sportId                   Int?
  sport                     String   @db.VarChar(50)
  facilityId                Int
  facilityName              String   @db.VarChar(255)
  facilitySurfaceType       String?  @db.VarChar(100)
  bookingDate               DateTime @db.Date
  startTime                 String   @db.VarChar(10)
  endTime                   String   @db.VarChar(10)
  totalHours                Float
  subtotal                  Float
  gstRate                   Float    @default(18)
  gstAmount                 Float    @default(0)
  totalAmount               Float
  platformCommissionPercent Float    @default(0)
  platformCommissionAmount  Float    @default(0)
  venueNetAmount            Float    @default(0)
  paymentType               String   @default("full") @db.VarChar(10)
  paidAmount                Float    @default(0)
  paymentStatus             String   @default("pending") @db.VarChar(20)
  paymentId                 String?  @db.VarChar(255)
  razorpayOrderId           String?  @db.VarChar(255)
  razorpayPaymentId         String?  @db.VarChar(255)
  status                    String   @default("pending") @db.VarChar(30)
  slotId                    Int?
  batchId                   Int?
  discountPercent           Float    @default(0)
  groupId                   String?  @db.VarChar(50)
  splitCount                Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  venue         Venue          @relation(fields: [venueId], references: [id])
  batch         Batch?         @relation(fields: [batchId], references: [id])
  sportRef      Sport?         @relation(fields: [sportId], references: [id])
  splitPayments SplitPayment[]
  addOnPurchases BookingAddOn[]
  openPlay      OpenPlay?
  matches       Match[]
  slots         Slot[]
  payments      BookingPayment[]
  refunds       Refund[]
  activities    Activity[]

  @@index([userId, status])
  @@index([venueId, facilityId, bookingDate, startTime, endTime, status])
  @@index([status, bookingDate])
  @@index([groupId])
  @@index([sportId])
  @@map("bookings")
}

model SplitPayment {
  id                  Int     @id @default(autoincrement())
  bookingId           Int
  userId              Int
  amount              Float
  status              String  @default("pending") @db.VarChar(20)
  splitType           String  @default("player_share") @db.VarChar(30) // player_share | host_protection | adjustment
  razorpayOrderId     String? @db.VarChar(255)
  razorpayPaymentId   String? @db.VarChar(255)
  walletTransactionId Int?
  createdAt           DateTime @default(now())

  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id])
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  @@index([bookingId, userId])
  @@index([bookingId, status])
  @@index([bookingId, splitType])
  @@map("split_payments")
}

model BookingAddOn {
  id          Int    @id @default(autoincrement())
  bookingId   Int
  name        String @db.VarChar(255)
  category    String? @db.VarChar(20)
  price       Float
  unit        String? @db.VarChar(20)
  quantity    Int    @default(1)
  amount      Float
  purchasedBy Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_add_ons")
}

model BookingPayment {
  id               Int      @id @default(autoincrement())
  bookingId        Int
  userId           Int
  amount           Float
  paymentMethod    String   @default("online") @db.VarChar(20)
  paymentGatewayId String?  @db.VarChar(255)
  razorpayOrderId  String?  @db.VarChar(255)
  status           String   @default("pending") @db.VarChar(20)
  splitIndex       Int?
  createdAt        DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([bookingId, userId])
  @@index([bookingId, status])
  @@map("booking_payments")
}

model Refund {
  id                Int      @id @default(autoincrement())
  bookingId         Int
  paymentId         Int?
  userId            Int
  splitIndex        Int?
  amountPaid        Float
  amountRefunded    Float
  platformFee       Float    @default(0)
  reason            String   @db.VarChar(20)
  razorpayPaymentId String   @db.VarChar(255)
  razorpayRefundId  String?  @db.VarChar(255)
  status            String   @default("pending") @db.VarChar(20)
  failureReason     String?  @db.VarChar(500)
  createdAt         DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@map("refunds")
}

// ─── Open Play ──────────────────────────────────────────────

model OpenPlay {
  id                   Int       @id @default(autoincrement())
  bookingId            Int       @unique
  venueId              Int
  sportId              Int?
  sport                String    @db.VarChar(50)
  formatName           String    @db.VarChar(100)
  playersPerTeam       Int
  maxPlayers           Int
  minimumPlayers       Int       @default(2)
  createdById          Int
  facilityId           Int?
  facilityName         String?   @db.VarChar(255)
  title                String?   @db.VarChar(255)
  status               String    @default("open") @db.VarChar(30)
  bookingDate          DateTime  @db.Date
  startTime            String?   @db.VarChar(10)
  endTime              String?   @db.VarChar(10)
  pricePerPlayer       Float?    @default(0)
  skillLevel           String?   @db.VarChar(20)
  skillRatingMin       Int?
  skillRatingMax       Int?
  notes                String?   @db.Text
  // Lifecycle fields
  joinDeadlineAt       DateTime?
  hostProtectionAmount Float     @default(0)
  hostProtectionStatus String    @default("none") @db.VarChar(20) // none | pending | paid | credited
  pricingLockedAt      DateTime?
  finalPlayerCount     Int?
  finalPricePerPlayer  Float?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  booking   Booking          @relation(fields: [bookingId], references: [id])
  venue     Venue            @relation(fields: [venueId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  sportRef  Sport?           @relation(fields: [sportId], references: [id])
  players   OpenPlayPlayer[]

  @@index([venueId, bookingDate, status])
  @@index([sport, status])
  @@index([sportId])
  @@index([createdById])
  @@index([joinDeadlineAt, status])
  @@map("open_plays")
}

model OpenPlayPlayer {
  id         Int @id @default(autoincrement())
  openPlayId Int
  userId     Int

  openPlay OpenPlay @relation(fields: [openPlayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([openPlayId, userId])
  @@map("open_play_players")
}

// ─── Matches ────────────────────────────────────────────────

model Match {
  id             Int      @id @default(autoincrement())
  activityId     Int?
  bookingId      Int?
  tournamentId   Int?
  sportId        Int
  sportName      String   @db.VarChar(50)
  formatName     String   @db.VarChar(100)
  playersPerTeam Int?
  venueId        Int?
  locationId     Int?
  matchType      String   @default("COMPETITIVE") @db.VarChar(20)
  loggingMode    String   @default("QUICK_RESULT") @db.VarChar(20)
  teams          Json?
  winnerTeam     String?  @db.VarChar(10)
  matchDate      DateTime
  scores         Json?
  scoreType      String   @default("simple") @db.VarChar(30)
  status         String   @default("scheduled") @db.VarChar(30)
  playerStats    Json?
  createdById    Int?
  statsProcessed Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location      Location?           @relation(fields: [locationId], references: [id])
  booking       Booking?            @relation(fields: [bookingId], references: [id])
  tournament    Tournament?         @relation(fields: [tournamentId], references: [id])
  sport         Sport               @relation(fields: [sportId], references: [id])
  venue         Venue?              @relation(fields: [venueId], references: [id])
  createdBy     User?               @relation("MatchCreator", fields: [createdById], references: [id])
  events        MatchEvent[]
  confirmations MatchConfirmation[]
  fixtures      TournamentFixture[]
  displays      VenueDisplay[]      @relation("DisplayCurrentMatch")
  pairings      DisplayPairing[]    @relation("PairingMatch")

  @@index([sportId])
  @@index([sportName])
  @@index([status])
  @@index([matchDate])
  @@index([venueId])
  @@index([tournamentId])
  @@index([bookingId])
  @@index([createdById])
  @@map("matches")
}

model MatchEvent {
  id             Int      @id @default(autoincrement())
  matchId        Int
  team           String   @db.VarChar(10)
  playerId       Int?
  eventType      String   @db.VarChar(50)
  eventValue     Int      @default(1)
  eventTimestamp  DateTime @default(now())
  metadata       Json?
  createdAt      DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player User? @relation(fields: [playerId], references: [id])

  @@index([matchId])
  @@index([matchId, team])
  @@index([matchId, playerId])
  @@index([matchId, eventType])
  @@map("match_events")
}

model MatchConfirmation {
  id          Int       @id @default(autoincrement())
  matchId     Int
  playerId    Int
  status      String    @default("PENDING") @db.VarChar(20)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player User  @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId, status])
  @@map("match_confirmations")
}

// ─── Tournaments ────────────────────────────────────────────

model Tournament {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  sportId         Int?
  sport           String   @db.VarChar(50)
  format          String   @default("league") @db.VarChar(20)
  stages          Json?
  matchFormatName String?  @db.VarChar(100)
  venueId         Int?
  locationId      Int?
  createdById     Int
  maxTeams        Int?
  teams           Json?
  registrations   Json?
  players         Json?
  sponsors        Json?
  status          String   @default("draft") @db.VarChar(20)
  winner          Json?
  runnerUp        Json?
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location      Location?                @relation(fields: [locationId], references: [id])
  venue         Venue?                   @relation(fields: [venueId], references: [id])
  createdBy     User                     @relation(fields: [createdById], references: [id])
  sportRef      Sport?                   @relation(fields: [sportId], references: [id])
  fixtures      TournamentFixture[]
  matches       Match[]
  announcements TournamentAnnouncement[]
  coOrganizers  TournamentCoOrganizer[]

  @@index([sport, status])
  @@index([sportId])
  @@index([createdById])
  @@index([venueId])
  @@map("tournaments")
}

model TournamentAnnouncement {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  title        String   @db.VarChar(255)
  body         String   @db.Text
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_announcements")
}

model TournamentCoOrganizer {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  userId       Int
  role         String   @default("manager") @db.VarChar(20)
  addedAt      DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation("CoOrganizerOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
  @@map("tournament_co_organizers")
}

model TournamentFixture {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  stage        Int?
  round        Int
  groupIndex   Int?
  matchOrder   Int
  team1Type    String   @default("team") @db.VarChar(10)
  team1Ref     Json
  team2Type    String   @default("team") @db.VarChar(10)
  team2Ref     Json
  matchId      Int?
  status       String   @default("pending") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?     @relation(fields: [matchId], references: [id])

  @@unique([tournamentId, stage, round, matchOrder, groupIndex])
  @@index([tournamentId])
  @@index([tournamentId, stage])
  @@map("tournament_fixtures")
}

// ─── Training ───────────────────────────────────────────────

model Batch {
  id                  Int      @id @default(autoincrement())
  trainerId           Int
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  locationId          Int?
  venueId             Int?
  venueDiscountPct    Float    @default(0)
  commissionPercent   Float    @default(0)
  sportId             Int?
  sport               String?  @db.VarChar(50)
  sportFees           Json?
  feeSchedules        Json?
  capacity            Int      @default(20)
  skillRatingMin      Int?
  skillRatingMax      Int?
  joinType            String   @default("instant") @db.VarChar(20)
  reservationPercent  Float    @default(100)
  schedule            Json?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trainer       User              @relation("TrainerBatches", fields: [trainerId], references: [id])
  location      Location?         @relation(fields: [locationId], references: [id])
  venue         Venue?            @relation(fields: [venueId], references: [id])
  sportRef      Sport?            @relation(fields: [sportId], references: [id])
  memberships   BatchMembership[]
  sessions      BatchSession[]
  payments      BatchPayment[]
  announcements BatchAnnouncement[]
  reviews       PlayerBatchReview[]
  bookings      Booking[]

  @@index([trainerId])
  @@index([venueId])
  @@index([sportId])
  @@map("batches")
}

model BatchMembership {
  id                Int      @id @default(autoincrement())
  batchId           Int
  playerId          Int
  joinDate          DateTime @default(now())
  status            String   @default("active") @db.VarChar(20)
  reservationStatus String   @default("confirmed") @db.VarChar(20)
  paymentStatus     String   @default("pending") @db.VarChar(20)
  createdAt         DateTime @default(now())

  batch  Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  player User  @relation(fields: [playerId], references: [id])

  @@unique([batchId, playerId])
  @@index([playerId])
  @@index([batchId, status])
  @@map("batch_memberships")
}

model BatchSession {
  id        Int      @id @default(autoincrement())
  batchId   Int
  date      DateTime @db.Date
  startTime String   @db.VarChar(10)
  endTime   String   @db.VarChar(10)
  status    String   @default("scheduled") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch      Batch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attendance SessionAttendance[]

  @@index([batchId, date])
  @@index([batchId, status])
  @@map("batch_sessions")
}

model SessionAttendance {
  id        Int      @id @default(autoincrement())
  sessionId Int
  playerId  Int
  status    String   @default("present") @db.VarChar(10)
  createdAt DateTime @default(now())

  session BatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  User         @relation(fields: [playerId], references: [id])

  @@unique([sessionId, playerId])
  @@index([playerId])
  @@map("session_attendance")
}

model BatchPayment {
  id                        Int      @id @default(autoincrement())
  batchId                   Int
  playerId                  Int?
  payerId                   Int
  cycleMonth                Int?
  cycleYear                 Int?
  paymentMode               String   @default("online") @db.VarChar(10)
  validationStatus          String   @default("pending") @db.VarChar(20)
  amount                    Float
  platformCommissionPercent Float    @default(0)
  platformCommissionAmount  Float    @default(0)
  trainerNetAmount          Float    @default(0)
  status                    String   @default("completed") @db.VarChar(20)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  batch  Batch @relation(fields: [batchId], references: [id])
  player User? @relation("PlayerPayments", fields: [playerId], references: [id])
  payer  User  @relation("PayerPayments", fields: [payerId], references: [id])

  @@index([batchId, playerId, cycleMonth, cycleYear])
  @@map("batch_payments")
}

model BatchAnnouncement {
  id        Int      @id @default(autoincrement())
  batchId   Int
  trainerId Int
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer User  @relation(fields: [trainerId], references: [id])

  @@index([batchId, createdAt])
  @@map("batch_announcements")
}

model PlayerBatchReview {
  id        Int      @id @default(autoincrement())
  batchId   Int
  playerId  Int
  trainerId Int
  year      Int
  month     Int
  ratings   Json?
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch   Batch @relation(fields: [batchId], references: [id])
  player  User  @relation("ReviewedPlayer", fields: [playerId], references: [id])
  trainer User  @relation("ReviewingTrainer", fields: [trainerId], references: [id])

  @@unique([batchId, playerId, year, month])
  @@index([playerId, year, month])
  @@map("player_batch_reviews")
}

// ─── Stats / Analytics ──────────────────────────────────────

model Activity {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(30)
  sportId     Int?
  sport       String   @db.VarChar(50)
  referenceId Int?
  venueId     Int?
  facilityId  Int?
  bookingId   Int?
  createdById Int?
  startTime   DateTime?
  endTime     DateTime?
  status      String   @default("scheduled") @db.VarChar(20)
  date        DateTime?
  createdAt   DateTime @default(now())

  venue          Venue?               @relation(fields: [venueId], references: [id])
  booking        Booking?             @relation(fields: [bookingId], references: [id])
  createdBy      User?                @relation("ActivityCreator", fields: [createdById], references: [id])
  sportRef       Sport?               @relation(fields: [sportId], references: [id])
  participants   ActivityParticipant[]
  activityStats  PlayerActivityStats[]
  sportEvents    SportEvent[]
  participations Participation[]

  @@index([type, referenceId])
  @@index([sport, startTime])
  @@index([sportId])
  @@index([venueId, startTime])
  @@index([bookingId])
  @@map("activities")
}

model ActivityParticipant {
  id         Int @id @default(autoincrement())
  activityId Int
  userId     Int

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@map("activity_participants")
}

model Participation {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  role       String   @default("player") @db.VarChar(20)
  teamId     String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@map("participations")
}

model SportEvent {
  id         Int      @id @default(autoincrement())
  activityId Int
  playerId   Int
  eventType  String   @db.VarChar(50)
  value      Json?
  timestamp  DateTime @default(now())
  metadata   Json?
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player   User     @relation(fields: [playerId], references: [id])

  @@index([activityId, timestamp])
  @@index([playerId, timestamp])
  @@index([activityId, eventType])
  @@map("sport_events")
}

model PlayerActivityStats {
  id         Int      @id @default(autoincrement())
  activityId Int
  playerId   Int
  sportId    Int?
  sport      String   @db.VarChar(50)
  stats      Json?
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player   User     @relation(fields: [playerId], references: [id])
  sportRef Sport?   @relation(fields: [sportId], references: [id])

  @@unique([activityId, playerId])
  @@index([playerId, sport])
  @@index([sportId])
  @@index([sport])
  @@map("player_activity_stats")
}

model PlayerStats {
  id            Int      @id @default(autoincrement())
  playerId      Int
  sportId       Int?
  sport         String   @db.VarChar(50)
  totalMatches  Int      @default(0)
  matchesWon    Int      @default(0)
  matchesLost   Int      @default(0)
  stats         Json?
  winPercentage Float    @default(0)
  lastUpdated   DateTime @default(now())

  player   User   @relation(fields: [playerId], references: [id])
  sportRef Sport? @relation(fields: [sportId], references: [id])

  @@unique([playerId, sport])
  @@index([sportId])
  @@map("player_stats")
}

// ─── Skill Rating ───────────────────────────────────────────

model SportSkillRating {
  id            Int      @id @default(autoincrement())
  userId        Int
  sportId       Int
  formatName    String   @default("overall") @db.VarChar(100)
  rating        Int      @default(1000)
  matchesPlayed Int      @default(0)
  winsCount     Int      @default(0)
  totalMOVSum   Float    @default(0)
  confidence    String   @default("unranked") @db.VarChar(12)
  lastUpdated   DateTime @default(now()) @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  sport Sport @relation(fields: [sportId], references: [id])

  @@unique([userId, sportId, formatName])
  @@index([sportId, formatName, rating])
  @@map("sport_skill_ratings")
}

model RatingHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  sportId    Int
  formatName String   @default("overall") @db.VarChar(100)
  oldRating  Int
  newRating  Int
  delta      Int
  activityId Int?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  sport Sport @relation(fields: [sportId], references: [id])

  @@index([userId, sportId, formatName, createdAt])
  @@map("rating_history")
}

// ─── Player Network ──────────────────────────────────────────

model PlayerConnection {
  id              Int      @id @default(autoincrement())
  userId          Int
  connectedUserId Int
  // "match" | "open_play" | "venue"
  connectionType  String   @db.VarChar(20)
  // populated when connectionType = "venue"
  venueId         Int?
  lastActivityAt  DateTime @default(now())
  playCount       Int      @default(1)
  createdAt       DateTime @default(now())

  user          User   @relation("UserConnections", fields: [userId], references: [id], onDelete: Cascade)
  connectedUser User   @relation("ConnectedTo", fields: [connectedUserId], references: [id], onDelete: Cascade)
  venue         Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([userId, connectedUserId, connectionType])
  @@index([userId, lastActivityAt])
  @@index([userId, playCount])
  @@map("player_connections")
}

model PeerPlayInvite {
  id                Int       @id @default(autoincrement())
  senderId          Int
  receiverId        Int
  sportId           Int
  sport             String    @db.VarChar(50)
  message           String?   @db.Text
  proposedDate      DateTime? @db.Date
  proposedStartTime String?   @db.VarChar(10)
  proposedEndTime   String?   @db.VarChar(10)
  status            String    @default("pending") @db.VarChar(20)
  respondedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sender   User  @relation("PeerInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User  @relation("PeerInviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sportRef Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([sportId, status])
  @@map("peer_play_invites")
}

// ─── Explicit Peer Relationships ──────────────────────────────

/**
 * Represents an explicit, user-initiated peer connection request.
 * Separate from derived PlayerConnection (activity-based suggestions).
 * Status lifecycle: pending → accepted | declined | removed
 */
model PeerRelationship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      String   @default("pending") @db.VarChar(20) // pending | accepted | declined | removed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("PeerRequester",  fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("PeerAddressee", fields: [addresseeId],  references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("peer_relationships")
}

// ─── Display / Scoreboard ────────────────────────────────────

// Permanent court/display identity within a venue
model VenueDisplay {
  id             Int       @id @default(autoincrement())
  venueId        Int
  courtName      String    @db.VarChar(100)
  status         String    @default("idle") @db.VarChar(20) // idle | awaiting | live
  currentMatchId Int?
  lastPingAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  venue    Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  match    Match?           @relation("DisplayCurrentMatch", fields: [currentMatchId], references: [id])
  pairings DisplayPairing[]

  @@index([venueId])
  @@map("venue_displays")
}

// Dynamic session token — generated per pairing attempt, expires after TTL
model DisplayPairing {
  id        Int       @id @default(autoincrement())
  displayId Int
  token     String    @unique @db.VarChar(64)
  matchId   Int?
  claimedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  display VenueDisplay @relation(fields: [displayId], references: [id], onDelete: Cascade)
  match   Match?       @relation("PairingMatch", fields: [matchId], references: [id])

  @@index([token])
  @@index([displayId])
  @@map("display_pairings")
}

// ─── Notification Preferences ────────────────────────────────

/**
 * One row per user. All booleans default to the product-recommended on/off.
 * Phase 2: add pushToken, webPushSubscription, deviceOs columns here.
 */
model NotificationPreference {
  id            Int     @id @default(autoincrement())
  userId        Int     @unique
  // Email preferences
  emailBookings Boolean @default(true)
  emailMatches  Boolean @default(true)
  emailPromo    Boolean @default(false)
  // In-app / push preferences
  pushBookings  Boolean @default(true)
  pushMatches   Boolean @default(true)
  pushInvites   Boolean @default(true)
  pushBatch     Boolean @default(true)
  pushWallet    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  body      String   @db.Text
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─── Web Push Subscriptions ──────────────────────────────────

/**
 * One row per browser/device subscription per user.
 * The endpoint + keys are sent by the browser PushManager and stored
 * here so the API can deliver Web Push notifications without FCM/APNs.
 */
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/**
 * Mobile push token registry for native iOS/Android clients.
 * Kept separate from PushSubscription to preserve existing web push behavior.
 */
model MobilePushToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  platform   String   @db.VarChar(20)   // ios | android
  token      String   @db.VarChar(512)
  appVersion String   @db.VarChar(30)
  deviceId   String?  @db.VarChar(191)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, token])
  @@index([userId, platform])
  @@index([token])
  @@map("mobile_push_tokens")
}

// ─── Sportza Wallet ──────────────────────────────────────────

/**
 * One wallet per user. Balance is kept in sync by wallet service
 * whenever a transaction is recorded. The source of truth is the
 * WalletTransaction ledger; `balance` is a cached running total.
 */
model WalletAccount {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  holds        WalletHold[]

  @@map("wallet_accounts")
}

/**
 * Immutable ledger entry for every wallet credit or debit.
 * `balanceAfter` is a snapshot of the wallet balance immediately after this entry.
 */
model WalletTransaction {
  id            Int      @id @default(autoincrement())
  walletId      Int
  userId        Int
  type          String   @db.VarChar(20)  // credit | debit
  amount        Float
  description   String   @db.VarChar(500)
  referenceType String?  @db.VarChar(50)  // open_play | booking | refund | manual
  referenceId   Int?
  balanceAfter  Float
  createdAt     DateTime @default(now())

  wallet        WalletAccount  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  splitPayments SplitPayment[]

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

/**
 * Temporary hold on wallet funds — prevents double-spend during checkout.
 * Released on payment completion or expiry.
 */
model WalletHold {
  id            Int       @id @default(autoincrement())
  walletId      Int
  amount        Float
  reason        String    @db.VarChar(200)
  referenceType String?   @db.VarChar(50)
  referenceId   Int?
  status        String    @default("active") @db.VarChar(20) // active | released | consumed
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  wallet WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([status, expiresAt])
  @@map("wallet_holds")
}

// ─── Admin / Operations ──────────────────────────────────────

/**
 * Immutable audit trail for all admin mutations.
 * Every admin action (suspend, role change, venue toggle, etc.) must
 * produce one row here in the same DB transaction.
 */
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  targetId   Int?
  targetType String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  payload    Json?
  ipAddress  String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  actor  User  @relation("AuditActor",  fields: [actorId],  references: [id])
  target User? @relation("AuditTarget", fields: [targetId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

/**
 * Approval queue for high-risk admin operations (financial adjustments,
 * permanent offboarding, etc.).  Initiator creates the request; a different
 * admin must review and approve/reject before execution.
 */
model AdminApprovalRequest {
  id          Int       @id @default(autoincrement())
  initiatorId Int
  reviewerId  Int?
  type        String    @db.VarChar(100)
  riskLevel   String    @default("high") @db.VarChar(20)
  status      String    @default("pending") @db.VarChar(20)
  payload     Json
  reason      String    @db.VarChar(500)
  reviewNote  String?   @db.VarChar(500)
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  initiator User  @relation("ApprovalInitiator", fields: [initiatorId], references: [id])
  reviewer  User? @relation("ApprovalReviewer",  fields: [reviewerId],  references: [id])

  @@index([status, createdAt])
  @@index([initiatorId])
  @@index([type, status])
  @@map("admin_approval_requests")
}
