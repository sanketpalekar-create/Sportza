# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your ngrok / cloudflared frontend URL here when sharing externally:
#   CLIENT_ORIGIN=http://localhost:5173,https://abc123.ngrok-free.app
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://Sanket:sanket@localhost:3306/sportza"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=sportza_dev_secret_change_in_production
DEV_AUTH_FALLBACK=false
DEV_FALLBACK_USER_ID=5

# Google OAuth — verifies One Tap ID tokens (must match VITE_GOOGLE_CLIENT_ID in apps/web/.env)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Auth0 (optional — only if using Auth0 JWT middleware)
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_AUDIENCE=https://sportza-api

# ─── Geocoding Provider ───────────────────────────────────────────────────────
# Mappls (MapMyIndia) — used first if present
# Get from: https://apis.mappls.com/console/
MAPPLS_API_KEY=YOUR_MAPPLS_REST_API_KEY_HERE

# Google Maps Geocoding — fallback if MAPPLS_API_KEY is absent
# Enable: Geocoding API | Restrict to server IP in production
# GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ─── Mobile Compatibility Flags ───────────────────────────────────────────────
# All flags are optional; defaults are false unless noted.
AUTH_MOBILE_V2=false
PAYMENTS_MOBILE_SDK=false
PUSH_MOBILE_TOKENS=false
MAPS_MOBILE_PROVIDER=mappls
DEEPLINK_MOBILE_ROUTES=false

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
