# ─── API ──────────────────────────────────────────────────────────────────────
# Local development (default)
VITE_API_URL=http://localhost:5000/api

# Vercel (same-origin rewrite — preferred for cookies):
#   VITE_API_URL=/api
# Or absolute:
#   VITE_API_URL=https://sportza.in/api

# When sharing via ngrok / cloudflared, replace with your backend public URL:
#   VITE_API_URL=https://abc123.ngrok-free.app/api
#   VITE_API_URL=https://abc123.trycloudflare.com/api

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Must match RAZORPAY_KEY_ID in apps/api/.env
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Same value as GOOGLE_CLIENT_ID in apps/api/.env
# Google Cloud → Credentials → OAuth 2.0 Web client → Authorized JavaScript origins:
#   http://localhost:5173
#   http://YOUR_LAN_IP:5173   (phone testing on same Wi‑Fi)
#   https://sportza.in
#   https://www.sportza.in
#   your ngrok/cloudflared origin (exact URL, no path)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# ─── Map Provider ─────────────────────────────────────────────────────────────
# Options: "mappls" (default, MapMyIndia) | "google" (Google Maps)
VITE_MAP_PROVIDER=mappls

# Mappls (MapMyIndia) — https://apis.mappls.com/console/
# Used when VITE_MAP_PROVIDER=mappls
VITE_MAPPLS_API_KEY=YOUR_MAPPLS_REST_API_KEY_HERE

# Google Maps — https://console.cloud.google.com
# Enable: Maps JavaScript API + Places API
# Used when VITE_MAP_PROVIDER=google (key is optional; Mappls is the default)
# VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ─── Auth0 (optional) ─────────────────────────────────────────────────────────
# VITE_AUTH0_DOMAIN=your-domain.auth0.com
# VITE_AUTH0_CLIENT_ID=your-client-id
# VITE_AUTH0_AUDIENCE=https://sportza-api
