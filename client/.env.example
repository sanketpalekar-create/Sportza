# Sportza client — environment variables (copy to .env and fill)
# These are baked into the build at npm run build time.

# API base URL (no trailing slash). In production, set to your deployed API.
REACT_APP_API_URL=http://localhost:5000/api

# Optional: OAuth (same values as server for consistency)
# REACT_APP_GOOGLE_CLIENT_ID=
# REACT_APP_FACEBOOK_APP_ID=
